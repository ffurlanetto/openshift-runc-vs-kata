{#- Pod consommateur de secrets (phase SCR). Identique pour runc et kata hormis runtimeClassName.
    Paramètres : name, secret_volumes (liste {name, secret, items?, default_mode?, optional?}),
    projected (bool), subpaths (liste {secret, key, path}), env_secrets (liste {var, secret, key}),
    rc (RuntimeClass forcée : "runc" | nom | none = celle du run), node_name, sa_token ({audience, ttl}). -#}
{%- set rc = rc | default(none) %}
{%- set eff_rc = none if rc == "runc" else (rc or runtime_class) %}
apiVersion: v1
kind: Pod
metadata:
  name: {{ name }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: kvr
spec:
{%- if eff_rc %}
  runtimeClassName: {{ eff_rc }}
{%- endif %}
{%- if node_name | default(none) %}
  nodeName: {{ node_name }}
{%- elif node_selector %}
  nodeSelector:
{%- for k, v in node_selector.items() %}
    {{ k }}: "{{ v }}"
{%- endfor %}
{%- endif %}
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  automountServiceAccountToken: false
  containers:
    - name: main
      image: {{ images.ubi_minimal }}
      imagePullPolicy: IfNotPresent
      command: ["sleep", "infinity"]
      resources:
        requests: {cpu: 50m, memory: 64Mi}
        limits: {cpu: 500m, memory: 256Mi}
      securityContext:
        allowPrivilegeEscalation: false
        runAsNonRoot: true
{%- if platform == "kubernetes" %}
        runAsUser: 1001
{%- endif %}
        capabilities: {drop: ["ALL"]}
        seccompProfile: {type: RuntimeDefault}
{%- if env_secrets | default([]) %}
      env:
{%- for e in env_secrets %}
        - name: {{ e.var }}
          valueFrom: {secretKeyRef: {name: {{ e.secret }}, key: {{ e.key }}}}
{%- endfor %}
{%- endif %}
      volumeMounts:
{%- for v in secret_volumes | default([]) %}
        - {name: {{ v.name }}, mountPath: /secrets/{{ v.name }}, readOnly: true}
{%- endfor %}
{%- for s in subpaths | default([]) %}
        - {name: sp-{{ loop.index }}, mountPath: {{ s.path }}, subPath: {{ s.key }}, readOnly: true}
{%- endfor %}
{%- if projected | default(false) %}
        - {name: projected, mountPath: /secrets/projected, readOnly: true}
{%- endif %}
{%- if sa_token | default(none) %}
        - {name: sa-token, mountPath: /var/run/kvr-token, readOnly: true}
{%- endif %}
        - {name: tmp, mountPath: /tmp}
  volumes:
    - {name: tmp, emptyDir: {}}
{%- for v in secret_volumes | default([]) %}
    - name: {{ v.name }}
      secret:
        secretName: {{ v.secret }}
{%- if v.optional | default(false) %}
        optional: true
{%- endif %}
{%- if v.default_mode | default(none) %}
        defaultMode: {{ v.default_mode }}
{%- endif %}
{%- if "items" in v %}
        items:
{%- for it in v["items"] %}
          - {key: {{ it.key }}, path: {{ it.path }}{% if it.mode | default(none) %}, mode: {{ it.mode }}{% endif %}}
{%- endfor %}
{%- endif %}
{%- endfor %}
{%- for s in subpaths | default([]) %}
    - name: sp-{{ loop.index }}
      secret: {secretName: {{ s.secret }}}
{%- endfor %}
{%- if projected | default(false) %}
    - name: projected
      projected:
        sources:
          - secret: {name: {{ projected_secret }}, items: [{key: small, path: secret-small}]}
          - downwardAPI: {items: [{path: pod-name, fieldRef: {fieldPath: metadata.name}}]}
{%- endif %}
{%- if sa_token | default(none) %}
    - name: sa-token
      projected:
        sources:
          - serviceAccountToken: {path: token, {% if sa_token.audience | default(none) %}audience: {{ sa_token.audience }}, {% endif %}expirationSeconds: {{ sa_token.ttl }}}
{%- endif %}
