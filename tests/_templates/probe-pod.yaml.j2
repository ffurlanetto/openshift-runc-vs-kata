{#- Pod « sonde » commun : identique pour runc et kata, seule la ligne runtimeClassName change. -#}
apiVersion: v1
kind: Pod
metadata:
  name: {{ name | default("probe") }}
  namespace: {{ namespace }}
  labels:
    app.kubernetes.io/part-of: kvr
spec:
{%- if runtime_class_override | default(none) %}
  runtimeClassName: {{ runtime_class_override }}
{%- elif runtime_class %}
  runtimeClassName: {{ runtime_class }}
{%- endif %}
{%- if host_network | default(false) %}
  hostNetwork: true
{%- endif %}
{%- if node_selector %}
  nodeSelector:
{%- for k, v in node_selector.items() %}
    {{ k }}: "{{ v }}"
{%- endfor %}
{%- endif %}
  restartPolicy: Never
  terminationGracePeriodSeconds: 0
  automountServiceAccountToken: false
  containers:
    - name: main
      image: {{ images.ubi_minimal }}
      imagePullPolicy: IfNotPresent
      command: ["sleep", "infinity"]
      resources:
        requests: {cpu: 100m, memory: 64Mi}
        limits: {cpu: 500m, memory: 256Mi}
      securityContext:
        allowPrivilegeEscalation: false
        runAsNonRoot: true
{%- if platform == "kubernetes" %}
        runAsUser: 1001          # OpenShift attribue un UID via la SCC ; Kubernetes non
{%- endif %}
        capabilities: {drop: ["ALL"]}
        seccompProfile: {type: RuntimeDefault}
